{
  "name": "thirdfade",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "CONTACT_EMAIL": "info@thirdfade.com",
    "TURNSTILE_HOSTNAME": "thirdfade.com"
  }
}